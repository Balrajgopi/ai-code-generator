# Free AI Orchestration System — Environment Variables
# =====================================================
# Copy this file to .env and fill in your values.
# NEVER commit your .env file to git!

# ---------------------------------------------------
# REQUIRED: Google Gemini API Key (completely free)
# Get it here: https://aistudio.google.com/app/apikey
# Model used: gemini-2.0-flash (free tier, current as of 2025)
# ---------------------------------------------------
GROQ_API_KEY=your-GROQ_API_KEY


# ---------------------------------------------------
# OPTIONAL: Ollama settings (defaults shown)
# ---------------------------------------------------
# URL where Ollama is running (default: local)
OLLAMA_URL=http://localhost:11434

# Model to use for backend tasks. Options:
#   codellama   → Best for code generation (recommended)
#   mistral     → Great general-purpose model
#   llama3      → Latest Llama, very capable
OLLAMA_MODEL=codellama
